rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() {
      return request.auth != null;
    }

    // Memórias e capas custom: só Admin SDK (+ signed URLs).
    match /memorias/{pareamentoId}/{uid}/{tarefaId}/{fileName} {
      allow read, write: if false;
    }

    match /custom_momentos/{pareamentoId}/{uid}/{fileName} {
      allow read, write: if false;
    }

    match /profile_pics/{uid}/{fileName} {
      allow read, write: if isAuthed() && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
